
# --- Jenkins admin ---
TF_VAR_jenkins_admin_username=admin
TF_VAR_jenkins_admin_password=change-me

# --- GitHub credentials (Jenkins JCasC + Argo CD repo access) ---
TF_VAR_github_username=your-github-username
TF_VAR_github_pat=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

TF_VAR_infra_repo_url=https://github.com/bigmasy/DevOps_hw.git
TF_VAR_infra_repo_branch=main

# Репозиторій django-app-ci з Jenkinsfile — саме його клонує pipeline goit-django-docker
TF_VAR_django_repo_url=https://github.com/bigmasy/django-app-ci.git
TF_VAR_django_repo_branch=main

# --- ECR / Docker image ---
TF_VAR_ecr_image_tag=latest

# --- Jenkins public URL (для GitHub-webhook callback) ---
# Залиште порожнім на перший apply — hostname LoadBalancer ще невідомий.
# Після apply виконайте: kubectl get svc -n jenkins jenkins
# і підставте сюди зовнішню адресу (http://<LB-hostname>/), потім запустіть apply повторно.
TF_VAR_jenkins_url=

# --- Шлях до Helm-чарта застосунку в infra-репозиторії (Jenkins оновлює тег тут, Argo CD звідси деплоїть) ---
TF_VAR_app_chart_path=charts/django-app

# --- Автор автоматичних комітів Jenkins (оновлення image.tag) ---
TF_VAR_git_commit_email=jenkins@localhost
TF_VAR_git_commit_name=jenkins-ci

# --- Django-застосунок: namespace + реальні креди (Kubernetes Secret, не git) ---
TF_VAR_app_namespace=django
TF_VAR_django_secret_key=change-me-to-a-random-50-char-string
TF_VAR_django_postgres_password=change-me

# --- module.rds (вимкнений за замовчуванням — enable_rds=false) ---
# Щоб реально підняти RDS/Aurora, розкоментуйте/встановіть у true і задайте
# rds_password. Деталі всіх змінних — modules/rds/README.md
TF_VAR_enable_rds=false
TF_VAR_rds_use_aurora=false
TF_VAR_rds_password=change-me
